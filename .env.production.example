# Production environment template (OR-052). Copy the values into the hosting platform's
# secret/environment settings. Never commit real values. Empty values must be filled
# unless marked optional. See infrastructure/DEPLOYMENT.md for each variable.

# --- Backend (API) ---
APP_ENV=production
# Production Supabase project (NOT the development project), port 5432 (direct or session pooler).
POSTGRES_URL=
# The deployed store's origin(s), https only, comma-separated, no paths, no "*".
CORS_ORIGINS=
# Optional: reverse proxies / the Next.js server whose X-Forwarded-For is trusted.
TRUSTED_PROXIES=
ORIFLAME_COUNTRY=PK
# official_url or manual_code (ADR-002). Leave the URL and code empty to run in restricted mode.
ORIFLAME_REFERRAL_METHOD=official_url
ORIFLAME_REFERRAL_URL=
ORIFLAME_CONSULTANT_CODE=
# Only "fixture" exists until ADR-001 accepts a permitted source; fixtures refuse production.
CATALOGUE_SOURCE=fixture
AVAILABILITY_MAX_AGE_HOURS=24

# --- Frontend (Next.js) ---
APP_ENV=production
# Build time and runtime: the store's public origin, e.g. https://example.pk
SITE_URL=
# Build time: the public API base URL, e.g. https://api.example.pk
NEXT_PUBLIC_API_BASE_URL=
# Optional public contact details for /contact.
CONTACT_EMAIL=
CONTACT_WHATSAPP=
