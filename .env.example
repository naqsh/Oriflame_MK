# Copy to .env and fill in real values locally. Never commit .env.
# The repository is public: keep this file free of real credentials and codes.

# --- Backend ---
# Supabase connection string (Dashboard -> Connect -> Direct connection or Session pooler, port 5432).
# Paste the password without the [ ] brackets and URL-encode special characters. See docs/DATABASE.md.
POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
APP_ENV=development

# Tests only: a throwaway PostgreSQL (local container or `supabase start`), never the hosted project.
# Database tests fail with a setup message when this is unset. See docs/guidence/try-it-locally.md.
TEST_POSTGRES_URL=
CORS_ORIGINS=http://localhost:3000

# --- Referral configuration (server-side only; see docs/REFERRAL.md) ---
ORIFLAME_COUNTRY=PK
ORIFLAME_CONSULTANT_CODE=
ORIFLAME_REFERRAL_URL=
ORIFLAME_REFERRAL_METHOD=official_url

# --- Frontend (public, non-secret; inlined at build time - set before npm run build) ---
# Next.js reads frontend/.env.local, not this root file. In development it defaults to http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
