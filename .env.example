# Copy to .env and fill in real values locally. Never commit .env.
# The repository is public: keep this file free of real credentials and codes.

# --- Backend ---
# Supabase connection string (Dashboard -> Connect -> Direct connection or Session pooler, port 5432).
# Paste the password without the [ ] brackets and URL-encode special characters. See docs/DATABASE.md.
POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
APP_ENV=development

# Tests only: a throwaway PostgreSQL (local container or `supabase start`), never the hosted project.
# Database tests fail with a setup message when this is unset. See docs/guidence/try-it-locally.md.
TEST_POSTGRES_URL=
CORS_ORIGINS=http://localhost:3000
# Reverse proxies whose X-Forwarded-For the API trusts for per-client rate limits (comma-
# separated addresses, e.g. the Next.js server). Empty: the direct peer address is used.
TRUSTED_PROXIES=

# --- Referral configuration (server-side only; see docs/REFERRAL.md) ---
ORIFLAME_COUNTRY=PK
ORIFLAME_CONSULTANT_CODE=
ORIFLAME_REFERRAL_URL=
ORIFLAME_REFERRAL_METHOD=official_url

# --- Catalogue source (see docs/CATALOGUE-DATA.md, docs/CATALOGUE-CSV.md and ADR-001) ---
# "fixture": development fixtures (refused when APP_ENV=production).
# "csv": the owner's own product list (template: docs/templates/catalogue-template.csv).
CATALOGUE_SOURCE=fixture
# Required when CATALOGUE_SOURCE=csv. Relative paths are from the repository root;
# data/ is git-ignored, so the list is never committed.
CATALOGUE_CSV_PATH=
# Hours a source's in/out-of-stock check stays valid (1-720). Older data shows as
# "Availability not confirmed". No source provides availability yet (ADR-001).
AVAILABILITY_MAX_AGE_HOURS=24

# --- Frontend (public, non-secret; inlined at build time - set before npm run build) ---
# Next.js reads frontend/.env.local, not this root file. In development it defaults to http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Public origin for canonical URLs, Open Graph, sitemap and robots.txt (not secret).
# Required for production builds; development defaults to http://localhost:3000.
SITE_URL=http://localhost:3000
# Optional, owner-approved public contact details for /contact (server-side, read per request).
# WhatsApp in international format, digits only (e.g. 92XXXXXXXXXX). Leave empty to hide.
CONTACT_EMAIL=
CONTACT_WHATSAPP=
# Only APP_ENV=production deployments are indexable (robots.txt, sitemap).
